# =============================================================================
# Dev container para PHP usado como backend de PhpStorm (JetBrains Remote Dev).
# Incluye Composer. Cambia el tag de PHP (8.4 -> 8.5, etc.) según necesites.
#
# Construir con tu UID:
#   podman build --build-arg USER_ID=$(id -u) --build-arg GROUP_ID=$(id -g) \
#     -t localhost/devcontainer-php:latest .
# =============================================================================
FROM docker.io/library/php:8.4-cli-bookworm

ARG USER_ID=1000
ARG GROUP_ID=1000

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    unzip \
    ca-certificates \
    tar \
    procps \
    libzip-dev \
    && docker-php-ext-install zip \
    && rm -rf /var/lib/apt/lists/*

# Composer desde su imagen oficial (evita el script de instalación remoto).
COPY --from=docker.io/library/composer:2 /usr/bin/composer /usr/bin/composer

# Usuario no-root que coincide con tu UID de host.
RUN groupadd -g ${GROUP_ID} dev 2>/dev/null || true && \
    useradd -m -u ${USER_ID} -g ${GROUP_ID} -s /bin/bash dev 2>/dev/null || true

# Caché de Composer dentro del home (persiste vía volumen del dev container).
ENV COMPOSER_HOME="/home/dev/.composer"

USER dev
WORKDIR /home/dev
