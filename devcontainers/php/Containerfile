# =============================================================================
# PHP dev container, used as the PhpStorm backend (JetBrains Remote Dev).
# Includes Composer. Change the PHP tag (8.4 -> 8.5, etc.) as needed.
#
# The 'dev' user is pinned to UID/GID 1000, the same as the Claude jail: the
# devcontainer.json maps your host user onto it with 'keep-id:uid=1000', so
# workspace files come out owned by YOU on the host whatever your host UID is.
# Do not build it with your own UID: the mapping would no longer line up.
#   podman build -t localhost/devcontainer-php:latest .
# =============================================================================
FROM docker.io/library/php:8.4-cli-bookworm

ARG USER_ID=1000
ARG GROUP_ID=1000

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    unzip \
    ca-certificates \
    tar \
    procps \
    libzip-dev \
    && docker-php-ext-install zip \
    && rm -rf /var/lib/apt/lists/*

# Composer from its official image (avoids the remote installer script).
COPY --from=docker.io/library/composer:2 /usr/bin/composer /usr/bin/composer

# Non-root user at UID 1000 (see the header). useradd is deliberately NOT
# followed by '|| true': if it fails, 'USER dev' below would produce an image
# that cannot start, and failing the build is far easier to diagnose.
RUN groupadd -g ${GROUP_ID} dev 2>/dev/null || true; \
    useradd -l -m -u ${USER_ID} -g ${GROUP_ID} -s /bin/bash dev

# Composer cache inside the home directory (persisted via the dev container volume).
ENV COMPOSER_HOME="/home/dev/.composer"

USER dev
WORKDIR /home/dev
