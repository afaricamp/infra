{
  "name": "go-dev-jailed",
  "image": "localhost/devcontainer-go:latest",

  // Container hardening. Slightly less strict than the Claude jail: FOWNER and
  // CHOWN are required for the JetBrains Gateway worker to chmod/chown while
  // deploying its backend. With --userns=keep-id those capabilities only apply
  // INSIDE the user namespace (your subuid range), so the real blast radius is
  // still limited to your own files.
  // If JetBrains ignores an arg, check with: podman inspect <container>
  "runArgs": [
    "--cap-drop=ALL",
    "--cap-add=FOWNER",
    "--cap-add=CHOWN",
    "--security-opt=no-new-privileges",
    "--pids-limit=2048",
    "--memory=16g",
    "--memory-swap=16g",
    // Rootless UID mapping: inside you are 1000 (owner of the image's home),
    // on the host files come out owned by YOU. If you hit startup or
    // ownership problems, this is the first line to adjust or drop.
    "--userns=keep-id:uid=1000,gid=1000"
  ],

  "remoteUser": "dev",

  // The project source is mounted here inside the container.
  "workspaceFolder": "/home/dev/project",

  "containerEnv": {
    "TMPDIR": "/home/dev/tmp"
  },

  // Create TMPDIR and validate the toolchain when the environment is built.
  "onCreateCommand": "mkdir -p /home/dev/tmp && go version"
}
