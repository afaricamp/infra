# =============================================================================
# Go dev container, used as the GoLand backend (JetBrains Remote Dev).
# The IDE backend installs itself here at runtime; this image only provides the
# toolchain and the bare minimum JetBrains needs.
#
# Build it with your UID so workspace files come out owned by YOU on the host:
#   podman build --build-arg USER_ID=$(id -u) --build-arg GROUP_ID=$(id -g) \
#     -t localhost/devcontainer-go:latest .
# =============================================================================
FROM docker.io/library/golang:1.24-bookworm

ARG USER_ID=1000
ARG GROUP_ID=1000

# JetBrains needs: glibc (bookworm has it), git, curl, tar, procps.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    tar \
    procps \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Non-root user matching your host UID.
RUN groupadd -g ${GROUP_ID} dev 2>/dev/null || true && \
    useradd -m -u ${USER_ID} -g ${GROUP_ID} -s /bin/bash dev 2>/dev/null || true

# Go caches inside the user's home (persisted via the dev container volume).
ENV GOPATH="/home/dev/go"
ENV GOCACHE="/home/dev/.cache/go-build"
ENV PATH="/usr/local/go/bin:/home/dev/go/bin:${PATH}"

USER dev
WORKDIR /home/dev
