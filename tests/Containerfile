# Runner for the unit tests (tests/unit): bats plus the tools the Makefile and
# the scripts under test expect. Built and used by 'make test-unit' when bats
# is not installed on the host.
FROM docker.io/bats/bats:1.11.1@sha256:e56e7c49087cb766b1ba9c5732b8f5402d289252d52f64e1eefb88269f74125c
RUN apk add --no-cache make coreutils git python3 zsh
