#!/bin/bash
# Fake podman for the unit tests. Never touches containers: it logs what it
# was asked to do and answers from environment variables.
#
#   STUB_LOG            every call appended as one line ("$*")
#   STUB_LOG.run        the arguments of the last 'podman run', one per line
#   STUB_VOLUMES        space-separated volumes that "exist"
#   STUB_ROOT           where their fake mountpoints live
#   STUB_PROXY_RUNNING  answer to 'container inspect -f {{.State.Running}}'
#   STUB_PROXY_IP       answer to 'container inspect' for the proxy's address
#                       (default 10.89.0.2; set it empty for "not attached")
#   STUB_CACHE_RUNNING  the same two, for the dependency cache ($JAIL_CACHE,
#   STUB_CACHE_IP       default claude-cache; 10.89.0.3). Unset: no cache.
#   STUB_NETWORKS       space-separated networks that "exist"
#   STUB_NET_DNS        answer to 'network inspect -f {{.DNSEnabled}}' (default false)
#   STUB_NET_RM_FAIL    set to make 'network rm' fail (a container still uses it)
#   STUB_LOG.removed    networks removed so far; they no longer "exist"
#   STUB_IMAGE_EXISTS   exit status of 'image exists' (default 0)
#   The volume check ('podman run ... --entrypoint stat ... /check/<vol>')
#   is answered here and logged to STUB_LOG.check, not STUB_LOG.run:
#   STUB_OWNER          owner of each volume inside the jail (default 1000, you)
#   STUB_SELINUX_CTX    their SELinux context (default '?', no SELinux)
#   STUB_UNREADABLE     volumes stat cannot read (Permission denied)
#   STUB_CHECK_FAIL     set to make the check container fail to start
#   STUB_ARCH           answer to 'info --format {{.Host.Arch}}' (default amd64;
#                       'none' makes it fail)
#   For doctor.sh: STUB_PODMAN_VERSION (5.6.0), STUB_ROOTLESS (true),
#   STUB_CGROUPS (v2), STUB_NET_BACKEND (netavark), STUB_MACHINE_STATE
#   (running; 'none' = no machine), STUB_MACHINE_ROOTFUL (false),
#   STUB_MACHINE_MEMORY (8192), STUB_MACHINE_MOUNTS (folders the VM shares,
#   one per line). 'container exists' is true when STUB_PROXY_RUNNING is set.
#   The jail itself ('podman run' of anything else):
#   STUB_RUN_EFFECT     shell snippet run in the current directory, as if
#                       Claude had changed the project (e.g. 'echo x >> Makefile')
#   STUB_RUN_EXIT       its exit status (default 0)
#   skopeo for bump-images.sh ('podman run ... inspect --raw docker://<ref>'):
#   The proxy's log for egress-log.sh ('podman logs ...'):
#   STUB_PROXY_LOG      file printed as the log (nothing when unset)
#   STUB_LOGS_ERROR     makes 'podman logs' fail with this message, exit 125
#   STUB_MANIFESTS      directory with the raw manifest of each ref, in a file
#                       named after the ref with '/' as '_'; no file = the
#                       registry does not know the tag
log="${STUB_LOG:-/dev/null}"
printf '%s\n' "$*" >> "$log"
last="${*: -1}"

volume_exists() {
  case " ${STUB_VOLUMES:-} " in *" $1 "*) return 0 ;; esac
  return 1
}

case "$1 ${2:-}" in
  "volume inspect")
    volume_exists "$last" || exit 125
    echo "${STUB_ROOT:-/nonexistent}/volumes/$last/_data" ;;
  "volume exists")
    volume_exists "$last" ;;
  "container inspect")
    if [ "$last" = "${JAIL_CACHE:-claude-cache}" ]; then
      [ -n "${STUB_CACHE_RUNNING:-}" ] || exit 125
      case "$*" in
        *IPAddress*) echo "${STUB_CACHE_IP-10.89.0.3}" ;;
        *) echo "$STUB_CACHE_RUNNING" ;;
      esac
      exit 0
    fi
    [ -n "${STUB_PROXY_RUNNING:-}" ] || exit 125
    case "$*" in
      *IPAddress*) echo "${STUB_PROXY_IP-10.89.0.2}" ;;
      *) echo "$STUB_PROXY_RUNNING" ;;
    esac ;;
  "image exists")
    exit "${STUB_IMAGE_EXISTS:-0}" ;;
  "info --format")
    case "$3" in
      *Arch*)
        # STUB_ARCH=none: podman cannot answer.
        [ "${STUB_ARCH:-amd64}" = none ] && exit 125
        echo "${STUB_ARCH:-amd64}" ;;
      *Rootless*)       echo "${STUB_ROOTLESS:-true}" ;;
      *CgroupsVersion*) echo "${STUB_CGROUPS:-v2}" ;;
      *NetworkBackend*) echo "${STUB_NET_BACKEND:-netavark}" ;;
      *) exit 1 ;;
    esac ;;
  "version --format")
    echo "${STUB_PODMAN_VERSION:-5.6.0}" ;;
  "machine inspect")
    [ "${STUB_MACHINE_STATE:-running}" = none ] && exit 125
    case "$*" in
      *State*)   echo "${STUB_MACHINE_STATE:-running}" ;;
      *Rootful*) echo "${STUB_MACHINE_ROOTFUL:-false}" ;;
      *Memory*)  echo "${STUB_MACHINE_MEMORY:-8192}" ;;
      *) echo '[]' ;;
    esac ;;
  "machine ssh")
    printf '%s\n' "${STUB_MACHINE_MOUNTS:-}" ;;
  "container exists")
    if [ "$last" = "${JAIL_CACHE:-claude-cache}" ]; then [ -n "${STUB_CACHE_RUNNING:-}" ]; exit; fi
    [ -n "${STUB_PROXY_RUNNING:-}" ] ;;
  logs\ *)
    if [ -n "${STUB_LOGS_ERROR:-}" ]; then
      echo "Error: $STUB_LOGS_ERROR" >&2
      exit 125
    fi
    [ -z "${STUB_PROXY_LOG:-}" ] || cat "$STUB_PROXY_LOG" ;;
  "network exists")
    grep -qxF -- "$last" "$log.removed" 2>/dev/null && exit 1
    case " ${STUB_NETWORKS:-} " in *" $last "*) exit 0 ;; esac
    exit 1 ;;
  "network inspect")
    echo "${STUB_NET_DNS:-false}" ;;
  "network rm")
    [ -z "${STUB_NET_RM_FAIL:-}" ] || exit 2
    [ "$log" = /dev/null ] || printf '%s\n' "$last" >> "$log.removed" ;;
  "network create"|"network connect"|build\ *|"rm -f")
    ;;
  run\ *)
    shift
    case " $* " in
      *" inspect --raw docker://"*)
        ref="${last#docker://}"
        manifest="${STUB_MANIFESTS:-/nonexistent}/$(printf '%s' "$ref" | tr '/' '_')"
        if [ ! -f "$manifest" ]; then
          echo "FATA[0000] Error parsing image name 'docker://$ref': reading manifest: manifest unknown" >&2
          exit 1
        fi
        cat "$manifest"
        exit 0 ;;
      *" --entrypoint stat "*)
        [ "$log" = /dev/null ] || printf '%s\n' "$@" > "$log.check"
        if [ -n "${STUB_CHECK_FAIL:-}" ]; then
          echo "Error: localhost/claude-jail:latest: image not known"
          exit 125
        fi
        status=0
        for arg in "$@"; do
          case "$arg" in
            /check/*:*) ;;
            /check/*)
              case " ${STUB_UNREADABLE:-} " in
                *" ${arg#/check/} "*) echo "stat: cannot statx '$arg': Permission denied"; status=1 ;;
                *) echo "$arg ${STUB_OWNER:-1000} ${STUB_SELINUX_CTX:-?}" ;;
              esac ;;
          esac
        done
        exit "$status" ;;
    esac
    [ "$log" = /dev/null ] || printf '%s\n' "$@" > "$log.run"
    [ -z "${STUB_RUN_EFFECT:-}" ] || sh -c "$STUB_RUN_EFFECT"
    exit "${STUB_RUN_EXIT:-0}" ;;
  *)
    exit 1 ;;
esac
