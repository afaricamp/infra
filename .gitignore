# Claude Code binary (large), produced by 'make download-claude'
claude-jail/claude-bin

# Effective proxy allowlist, generated by setup-egress.sh from 'allowlist'
# (plus 'allowlist-dev' when ALLOW_DEV=1)
claude-jail/egress-hardening/allowlist.effective

# Editor and 'sed -i.bak' leftovers
*.bak

# JetBrains
.idea/

# Claude Code local settings (machine-specific; shared settings would be
# .claude/settings.json, which is not ignored)
.claude/settings.local.json

# devkit eval runs (claude plugin eval, skill-creator)
devkit/evals/results/
*-workspace/

# Local AI session notes (see .ai-sessions/README.md)
.ai-sessions/*
!.ai-sessions/README.md
