# =============================================================================
# Hardened container for Claude Code (Go development).
#
# IMPORTANT note about the UID:
#   The image pins claudeuser = UID 1000. You do NOT need to rebuild even if
#   your host user is not 1000: the launcher uses 'keep-id:uid=1000' to map
#   your host UID -> 1000 inside and back again.
#   Leave USER_ID/GROUP_ID at 1000 unless you know what you are doing.
# =============================================================================

# 1. Official Go image, used only as a source to copy the toolchain from
FROM docker.io/library/golang:1.27-bookworm AS go-source

# 2. Ubuntu base
FROM docker.io/library/ubuntu:24.04

# Copy Go across from the source image
COPY --from=go-source /usr/local/go /usr/local/go

# Environment so that 'go' is always on PATH
ENV PATH="/usr/local/go/bin:/home/claudeuser/go/bin:${PATH}"
ENV GOPATH="/home/claudeuser/go"
ENV GOCACHE="/home/claudeuser/.cache/go-build"

# The binary is baked into the image and updated with 'make update-claude';
# an in-container update would be thrown away by --rm anyway.
ENV DISABLE_AUTOUPDATER=1
# Keep ~/.claude.json (account and onboarding state) next to the credentials,
# inside the persistent 'claude-home' volume. Without this it lives in the
# image layer and is lost on every run.
ENV CLAUDE_CONFIG_DIR="/home/claudeuser/.claude"

# Essentials + build toolchain for Go packages that need CGO
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    procps \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# UID 1000 user (see the header note)
ARG USER_ID=1000
ARG GROUP_ID=1000
RUN userdel -f -r ubuntu || true && \
    groupadd -g ${GROUP_ID} claude-group || true && \
    useradd -l -m -u ${USER_ID} -g ${GROUP_ID} -s /bin/bash claudeuser

USER claudeuser
WORKDIR /home/claudeuser

# 'tmp' and '.config' matter here: the launcher exports
# TMPDIR=/home/claudeuser/tmp, and when that directory did not exist a lot of
# tools (git, compilers, anything using temp files) failed.
RUN mkdir -p .local/bin .claude project .cache/go-build go/bin tmp .config

# Inject the Claude binary
COPY --chown=claudeuser:claude-group claude-bin .local/bin/claude
RUN chmod +x .local/bin/claude

ENV PATH="/home/claudeuser/.local/bin:${PATH}"
WORKDIR /home/claudeuser/project

ENTRYPOINT ["claude"]
