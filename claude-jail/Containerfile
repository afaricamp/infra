# =============================================================================
# Hardened container for Claude Code, in four variants: one Containerfile,
# picked with --build-arg VARIANT=<name> ('make build-claude' builds them all;
# a project picks one with 'image' in its profile):
#
#   full  Go and Node 24 (the default, and what a plain 'podman build' gives)
#   go    Go only
#   node  Node 24 only (npm, pnpm and yarn through corepack)
#   php   PHP 8.4 and Composer, from the same images as the php dev container
#
# Each variant is a '<name>-tools' stage; the last stage, the jail itself, is
# the same for all of them. podman skips the stages a variant does not use,
# so building 'go' never pulls the PHP image.
#
# IMPORTANT note about the UID:
#   The image pins claudeuser = UID 1000. You do NOT need to rebuild even if
#   your host user is not 1000: the launcher uses 'keep-id:uid=1000' to map
#   your host UID -> 1000 inside and back again.
#   Leave USER_ID/GROUP_ID at 1000 unless you know what you are doing.
# =============================================================================
ARG VARIANT=full

# 1. Official images, used only as sources to copy the toolchains from. Keep
#    the Node major the same as in devcontainers/react and devcontainers/vue,
#    and PHP and Composer the same as in devcontainers/php: the jail runs the
#    tests against the node_modules and vendor/ the dev container installed,
#    and native modules and Composer's platform check need the same versions.
FROM docker.io/library/golang:1.27-bookworm@sha256:ce59b41415e2524ae99926fe1f37ce48ba8c194dcbd2a56a65436cdcefa2bd34 AS go-source
FROM docker.io/library/node:24-bookworm@sha256:49f7adaf9f1574bc45c20ea317139b39a59d7e758d0e93745e112fd85cb42623 AS node-source
FROM docker.io/library/composer:2@sha256:0049ce90b432795bf413a738b073963ada1a689e1a8708104684baafe94586ec AS composer-source

# 2. Ubuntu base of the go, node and full variants.
FROM docker.io/library/ubuntu:24.04@sha256:562111b88caa79c71391c0c4d3c2114a7d5c35915c20561fd893cb1e07929e6b AS ubuntu-base
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    procps \
    && rm -rf /var/lib/apt/lists/*

# 3. go: the Go toolchain, plus the C toolchain for packages that need CGO.
FROM ubuntu-base AS go-tools
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY --from=go-source /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:/home/claudeuser/go/bin:${PATH}"
ENV GOPATH="/home/claudeuser/go"
ENV GOCACHE="/home/claudeuser/.cache/go-build"

# 4. node: the binary, the bundled npm and corepack, and the headers node-gyp
#    compiles native modules against (without them it downloads them).
#    python3 and the C toolchain are for node-gyp too.
FROM ubuntu-base AS node-tools
RUN apt-get update && apt-get install -y --no-install-recommends build-essential python3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node-source /usr/local/bin/node /usr/local/bin/node
COPY --from=node-source /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=node-source /usr/local/include/node /usr/local/include/node
# npm, npx and corepack are symlinks into node_modules in the node image. They
# are recreated here rather than copied, because a copied launcher script no
# longer finds its own modules. 'corepack enable' adds the pnpm and yarn shims
# next to them (as root, before the switch to claudeuser).
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx && \
    ln -s ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack && \
    corepack enable && \
    node --version && npm --version
# npm's cache goes in ~/.cache, a persistent volume, so it survives --rm.
# Global installs ('npm i -g') go to ~/.local (bin/ is on PATH) instead of
# the root-owned /usr/local, and are lost on exit like anything else outside
# the volumes. corepack keeps pnpm and yarn in ~/.cache/node/corepack.
ENV NPM_CONFIG_CACHE="/home/claudeuser/.cache/npm"
ENV NPM_CONFIG_PREFIX="/home/claudeuser/.local"
ENV NPM_CONFIG_UPDATE_NOTIFIER="false"

# 5. full: node plus Go (the same three lines as in go-tools).
FROM node-tools AS full-tools
COPY --from=go-source /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:/home/claudeuser/go/bin:${PATH}"
ENV GOPATH="/home/claudeuser/go"
ENV GOCACHE="/home/claudeuser/.cache/go-build"

# 6. php: the official PHP image of the php dev container (Debian), with its
#    zip extension and Composer. Composer's cache goes in ~/.cache, a
#    persistent volume; COMPOSER_HOME (and any auth.json in it) does not.
FROM docker.io/library/php:8.4-cli-bookworm@sha256:93a0fed307238c5645ccff9d4b87625bd5b96fdfa987e243dab531fd6140bac8 AS php-tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    unzip \
    ca-certificates \
    procps \
    libzip-dev \
    && docker-php-ext-install zip \
    && rm -rf /var/lib/apt/lists/*
COPY --from=composer-source /usr/bin/composer /usr/bin/composer
ENV COMPOSER_CACHE_DIR="/home/claudeuser/.cache/composer"

# 7. The jail itself, the same for every variant.
# hadolint ignore=DL3006
FROM ${VARIANT}-tools

# The binary is baked into the image and updated with 'make update-claude';
# an in-container update would be thrown away by --rm anyway.
ENV DISABLE_AUTOUPDATER=1
# Keep ~/.claude.json (account and onboarding state) next to the credentials,
# inside the persistent 'claude-home' volume. Without this it lives in the
# image layer and is lost on every run.
ENV CLAUDE_CONFIG_DIR="/home/claudeuser/.claude"

# UID 1000 user (see the header note). Ubuntu ships one called 'ubuntu'.
ARG USER_ID=1000
ARG GROUP_ID=1000
RUN (userdel -f -r ubuntu 2>/dev/null || true) && \
    (groupadd -g ${GROUP_ID} claude-group 2>/dev/null || true) && \
    useradd -l -m -u ${USER_ID} -g ${GROUP_ID} -s /bin/bash claudeuser

USER claudeuser
WORKDIR /home/claudeuser

# 'tmp' and '.config' matter here: the launcher exports
# TMPDIR=/home/claudeuser/tmp, and when that directory did not exist a lot of
# tools (git, compilers, anything using temp files) failed.
RUN mkdir -p .local/bin .claude project .cache/go-build .cache/npm .cache/composer go/bin tmp .config

# Inject the Claude binary: last, so that 'make update-claude' only redoes
# this layer of each variant.
COPY --chown=${USER_ID}:${GROUP_ID} claude-bin .local/bin/claude
RUN chmod +x .local/bin/claude

ENV PATH="/home/claudeuser/.local/bin:${PATH}"
WORKDIR /home/claudeuser/project

ENTRYPOINT ["claude"]
