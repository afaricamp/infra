# Proxy de filtrado de salida (allowlist). Construido en local para no
# depender de imágenes de terceros.
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y tinyproxy-bin ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY tinyproxy.conf /etc/tinyproxy/tinyproxy.conf
COPY allowlist /etc/tinyproxy/allowlist
EXPOSE 8888
# -d = foreground (para que podman gestione el proceso)
ENTRYPOINT ["tinyproxy", "-d", "-c", "/etc/tinyproxy/tinyproxy.conf"]
