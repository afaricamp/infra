# Egress filtering proxy (allowlist). Built locally so we do not depend on
# third-party images.
FROM docker.io/library/ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends tinyproxy-bin ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY tinyproxy.conf /etc/tinyproxy/tinyproxy.conf
# allowlist.effective is generated by setup-egress.sh (base, or base plus
# allowlist-dev when ALLOW_DEV=1). Do not build this image by hand: use
# setup-egress.sh.
COPY allowlist.effective /etc/tinyproxy/allowlist
EXPOSE 8888
# -d = foreground (so podman manages the process)
ENTRYPOINT ["tinyproxy", "-d", "-c", "/etc/tinyproxy/tinyproxy.conf"]
